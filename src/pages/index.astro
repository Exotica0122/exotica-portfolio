---
import '../global.css';
import { PortfolioApp } from '../components/PortfolioApp';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Peter An — full-stack engineer. Selected work, experience, and contact." />
		<title>Peter An — Full-Stack Engineer</title>

		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem('pa-theme') || 'light';
					document.documentElement.setAttribute('data-theme', t);
				} catch (e) {}
				window.__loadStart = Date.now();
			})();
		</script>
	</head>
	<body>
		<!-- ===== first-visit loading screen (Exotica Software) ===== -->
		<div
			id="app-loader"
			class="fixed inset-0 z-[999] flex items-center justify-center opacity-100 transition-[opacity,visibility] duration-500 [background:radial-gradient(120%_90%_at_78%_-10%,color-mix(in_srgb,var(--magenta)_30%,transparent),transparent_60%),radial-gradient(90%_80%_at_10%_110%,color-mix(in_srgb,var(--pink)_14%,transparent),transparent_55%),var(--plum)]"
		>
			<div class="flex flex-col items-center">
				<div class="ld-logo relative mb-[34px] flex h-[98px] w-[98px] items-center justify-center">
					<span
						class="absolute left-1/2 top-1/2 h-[118px] w-[118px] -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-pink opacity-0 [animation:ld-ring_1900ms_cubic-bezier(0.2,0,0,1)_1150ms_infinite]"
					></span>
					<span
						class="absolute left-1/2 top-1/2 h-[118px] w-[118px] -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-magenta-light opacity-0 [animation:ld-ring_1900ms_cubic-bezier(0.2,0,0,1)_2050ms_infinite]"
					></span>
					<svg class="block overflow-visible" viewBox="0 0 140 140" width="98" height="98" role="img" aria-label="Exotica">
						<rect
							class="origin-left scale-x-0 opacity-0 [animation:ld-bar-in_520ms_var(--ease-brand)_200ms_forwards] [transform-box:fill-box]"
							x="23" y="16" width="100" height="26" rx="7" fill="#d190d4"
						></rect>
						<path
							class="origin-left scale-x-0 opacity-0 [animation:ld-bar-in_520ms_var(--ease-brand)_430ms_forwards] [transform-box:fill-box]"
							d="M 30 64 L 90 64 L 81 76 L 30 76 Z" fill="#FFB7CE" stroke="#FFB7CE" stroke-width="14" stroke-linejoin="round"
						></path>
						<rect
							class="origin-left scale-x-0 opacity-0 [animation:ld-bar-in_520ms_var(--ease-brand)_660ms_forwards] [transform-box:fill-box]"
							x="23" y="98" width="100" height="26" rx="7" fill="#7e2066"
						></rect>
					</svg>
					<span
						aria-hidden="true"
						class="absolute -bottom-1.5 -right-2 flex h-8 w-8 scale-0 items-center justify-center rounded-[9px] bg-paper opacity-0 shadow-[0_2px_10px_rgba(45,16,40,0.45)] [animation:ld-badge-in_460ms_var(--ease-brand)_1020ms_forwards]"
					>
						<svg viewBox="0 0 20 20" width="17" height="17">
							<path d="M 7 5 L 2 10 L 7 15" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
							<path d="M 13 5 L 18 10 L 13 15" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</span>
				</div>
				<div class="mb-6 flex flex-col items-center gap-2">
					<span
						class="translate-y-2 font-sans text-[26px] font-extrabold tracking-[-0.02em] text-paper-on-plum opacity-0 [animation:ld-fade-up_520ms_var(--ease-brand)_1180ms_forwards]"
					>Exotica</span>
					<span
						class="font-sans text-[11px] font-bold uppercase text-[#d190d4] opacity-0 [animation:ld-sub-in_620ms_var(--ease-brand)_1420ms_forwards]"
					>Software</span>
				</div>
				<div
					class="h-1 w-[210px] overflow-hidden rounded-full bg-[color:color-mix(in_srgb,var(--paper-on-plum)_16%,transparent)] opacity-0 translate-y-2 [animation:ld-fade-up_520ms_var(--ease-brand)_900ms_forwards]"
				>
					<span
						class="ld-fill block h-full w-[4%] rounded-full bg-gradient-to-r from-magenta-light to-pink shadow-[0_0_12px_color-mix(in_srgb,var(--pink)_60%,transparent)] [animation:ld-fill_2400ms_cubic-bezier(0.35,0,0.15,1)_700ms_forwards]"
					></span>
				</div>
				<div
					class="ld-cap mt-4 translate-y-2 font-mono text-[11.5px] uppercase tracking-[0.22em] text-muted-on-plum opacity-0 [animation:ld-fade-up_520ms_var(--ease-brand)_1000ms_forwards]"
				>Compiling</div>
			</div>
		</div>

		<PortfolioApp client:load />

		<script is:inline>
			(function dismissLoader() {
				function ready() {
					if (window.__appReady) return;
					window.__appReady = true;
					document.body.classList.add('app-ready');
					window.dispatchEvent(new Event('app-ready'));
				}
				var el = document.getElementById('app-loader');
				if (!el) { ready(); return; }
				var MIN_MS = 3000; // let the staged Exotica intro play out fully
				var elapsed = Date.now() - (window.__loadStart || Date.now());
				var wait = Math.max(0, MIN_MS - elapsed);
				requestAnimationFrame(function () {
					setTimeout(function () {
						ready();
						el.classList.add('done');
						setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 560);
					}, wait);
				});
			})();
		</script>
	</body>
</html>
